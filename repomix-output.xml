  "short_desc_feature_1": "...", "short_desc_feature_2": "...", "short_desc_feature_3": "...",
  "rank_math_description": "...",
  "lsi_keywords": ["...", "...", "..."],
  "alt_text_1": "...", "alt_text_2": "...", "alt_text_3": "..."
}

{reviewer_feedback_if_retry}
