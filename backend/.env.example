# ==========================================
# 🚀 KIACHAHYE.PK AI AGENTIC SYSTEM - ENV
# ==========================================

# === APP SECURITY (Khud ki banai hui random strings) ===
APP_AUTH_SECRET=replace-with-a-long-random-string
APP_JWT_SIGNING_KEY=replace-with-a-different-long-random-string

# === DATABASE (Supabase - Free) ===
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# === AI APIs (Both 100% FREE) ===
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# === SCRAPING (Playwright free hai, Firecrawl sirf emergency ke liye baad mein) ===
FIRECRAWL_API_KEY=

# === BROAD WEB DISCOVERY (Google Programmable Search - free 100/day) ===
# Optional backup: only used when the free tiers leave a corroboration gap.
# GOOGLE_SEARCH_CX from programmablesearchengine.google.com; API key from Cloud Console.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# === DEPLOYMENT ===
# Your real domain for automatic HTTPS via Caddy (e.g. panel.kiachahiye.com).
# Leave blank for local testing (falls back to localhost).
DOMAIN=

# === ERROR MONITORING (Self-Hosted GlitchTip - Phase 4 mein deploy karenge) ===
GLITCHTIP_DSN=

# === APP SETTINGS ===
ENV=development
SCRAPE_MIN_DELAY_SECONDS=3
LLM_INTER_PRODUCT_DELAY_SECONDS=2
LLM_MAX_RETRIES=4
# Max Chromium contexts open at once inside the shared scraping browser.
# This is the RAM ceiling for scraping (~150-250MB per context). Raise only
# against a measured RSS figure, never by guess.
MAX_PLAYWRIGHT_CONTEXTS=2
# Stop scraping early once this many sources are held AND one of them is the
# brand's OFFICIAL site (which corroboration treats as authoritative alone).
# Raise it if the Manual Review queue grows -- more sources means more chances
# to fill a field the brand's own page omits, at the cost of speed.
MIN_SOURCES_WITH_OFFICIAL=2
LOGIN_RATE_LIMIT=5/minute
